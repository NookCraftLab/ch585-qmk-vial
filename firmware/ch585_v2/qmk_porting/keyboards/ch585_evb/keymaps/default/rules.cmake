# ============================================================================
# ch585_evb 默认键位功能开关
# ============================================================================
# 这里是所有功能的总开关，ON = 编译对应代码 + Vial界面显示配置页
# 想开启某个功能，把 OFF 改成 ON，然后重新编译即可
# ============================================================================

# ----------------------------------------------------------------------------
# 无线功能（当前关闭，BLE代码作为普通源文件直接集成，不通过QMK无线框架）
# ----------------------------------------------------------------------------
set(BLE_ENABLE OFF CACHE BOOL "KB" FORCE)   # QMK官方BLE框架（我们不用，自己集成了沁恒协议栈）
set(ESB_ENABLE OFF CACHE BOOL "KB" FORCE)   # Nordic ESB 2.4G（我们不用）

# ----------------------------------------------------------------------------
# 基础功能（默认开启，大家都在用的）
# ----------------------------------------------------------------------------
set(EXTRAKEY_ENABLE ON CACHE BOOL "KB" FORCE)      # 多媒体键：音量加减/静音/亮度加减/播放暂停/上下曲等

# ----------------------------------------------------------------------------
# Vial 高阶功能（全开，这些在Vial界面里有对应的配置页，用户可图形化配置）
# ----------------------------------------------------------------------------
set(TAP_DANCE_ENABLE ON CACHE BOOL "KB" FORCE)      # 按键舞蹈：单击/双击/三击/长按触发不同动作
set(COMBO_ENABLE ON CACHE BOOL "KB" FORCE)           # 组合键：同时按多个键触发一个动作（如j+k=Esc）
set(KEY_OVERRIDE_ENABLE ON CACHE BOOL "KB" FORCE)    # 按键覆盖：修饰键+普通键的映射重写（如Shift+1改输出）
set(REPEAT_KEY_ENABLE ON CACHE BOOL "KB" FORCE)      # 重复键：按一下重复上一个键，支持交替重复

# ----------------------------------------------------------------------------
# QMK 原生功能（默认关闭，需要的话把OFF改成ON）
# 这些功能大多通过标准键码触发，Vial界面里不一定有专门配置页
# ----------------------------------------------------------------------------

# 小配列扩展类（对2x4极小配列很有用，建议后续开启）
set(ONESHOT_ENABLE ON CACHE BOOL "KB" FORCE)         # 一次性修饰键：按一下Ctrl粘到下一键，自动松开（小配列标配）
set(LEADER_ENABLE OFF CACHE BOOL "KB" FORCE)         # 引导键：按Leader+序列触发功能（如L+B+T=切蓝牙），8键扩展出几十种功能（高阶，需记序列）

# 打字体验类（自动行为，开了就一直生效）
set(AUTO_SHIFT_ENABLE OFF CACHE BOOL "KB" FORCE)     # 自动换挡：长按字母键自动输出大写（可省Shift键）（有争议，改变输入习惯）
set(SPACECADET_ENABLE ON CACHE BOOL "KB" FORCE)      # 太空学员：左Shift单击变(，右Shift单击变)（写代码标配，几乎都开）
set(CAPS_WORD_ENABLE ON CACHE BOOL "KB" FORCE)       # 大写单词：双击Shift后下一个单词自动大写，输完空格自动恢复（最近很流行，程序员必备）
set(SENTENCE_CASE_ENABLE OFF CACHE BOOL "KB" FORCE)  # 句首大写：句号+空格后下一个字母自动大写（较新，用的人少）

# 安全与防误触类
set(SECURE_ENABLE OFF CACHE BOOL "KB" FORCE)         # 安全锁定：锁键盘，需输入解锁序列才能用（小众）
set(ACHORDION_ENABLE OFF CACHE BOOL "KB" FORCE)      # 和弦防误触：修饰键要另一只手的键先按才生效（主要大键盘防误触，小配列意义不大）
